# Copie este arquivo para .env e preencha a chave.
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo. Padrão: gemini-3.6-flash (bom equilíbrio custo/qualidade).
# Alternativas: gemini-3.5-flash-lite (mais barato), gemini-3.5-flash (mais caro).
GEMINI_MODEL=gemini-3.6-flash

# Porta do servidor local.
PORT=5173
